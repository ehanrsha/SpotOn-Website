<Legal title="Privacy Policy — SpotOn" description="How the SpotOn parking app collects, uses, shares and deletes personal information.">
<header class="masthead">
  <h1>Privacy Policy</h1>
  <div class="dates">
    <span>Effective 26 August 2026</span>
    <span>Last updated 26 August 2026</span>
  </div>
</header>

<div class="layout">

<aside class="toc">
  <nav aria-label="Sections">
