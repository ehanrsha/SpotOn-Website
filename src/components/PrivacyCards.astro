---
const cards = [
  { icon: 'lock', pre: 'Payments ', key: 'secured by Stripe.', post: ' We never see your card number.' },
  { icon: 'eye', pre: 'Your car details are ', key: 'only shared during a booking.', post: '' },
  { icon: 'trash', pre: '', key: 'Delete your account', post: ' and data anytime, right from your profile.' },
];
const icons: Record<string, string> = {
  lock: 'M6.5 11h11a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5v-7A1.5 1.5 0 0 1 6.5 11ZM8 11V8a4 4 0 0 1 8 0v3M12 15v2',
  eye: 'M3 3l18 18M10.6 5.1A9.7 9.7 0 0 1 12 5c5 0 8.5 4.2 9.5 7-.4 1.1-1.2 2.4-2.3 3.6M6.5 6.9C4.6 8.3 3.4 10.2 2.5 12c1 2.8 4.5 7 9.5 7 1.5 0 2.8-.4 4-1M9.9 9.9a3 3 0 0 0 4.2 4.2',
  trash: 'M4 7h16M9.5 7V4.5h5V7M6.5 7l.8 12a1.5 1.5 0 0 0 1.5 1.4h6.4a1.5 1.5 0 0 0 1.5-1.4l.8-12M10 11v6M14 11v6',
};
---
<section id="privacy" class="privacy section section--alt">
  <div class="wrap">
    <div class="row">
      <h2 class="h-section" data-reveal>Your info<br class="br-m" /> stays yours.</h2>
      <a class="link" href="/privacy" data-reveal data-reveal-delay="80"><span>Read our Privacy Policy</span></a>
    </div>
    <ul class="cards">
      {cards.map((c, i) => (
        <li class="card" data-reveal data-reveal-delay={i * 80}>
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[c.icon]} /></svg></span>
          <p>{c.pre}<strong>{c.key}</strong>{c.post}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px 32px; flex-wrap: wrap; }
  .row .link { margin-bottom: 8px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: clamp(32px, 4.5vw, 56px); }
  .card { background: #fff; border-radius: var(--radius-card); padding: 32px; min-height: 220px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .card p { font-size: clamp(22px, 2.2vw, 26px); line-height: 1.19; font-weight: 600; letter-spacing: -0.02em; color: #6E6E73; }
  .card strong { color: var(--ink); }
  .ico { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: #fff; }
  .br-m { display: none; }
  @media (max-width: 1068px) { .card { padding: 26px; } }
  @media (max-width: 734px) {
    .cards { grid-template-columns: 1fr; gap: 14px; }
    .card { min-height: 190px; padding: 28px; }
    .br-m { display: inline; }
  }
</style>
