---
const steps = [
  { label: 'Find a spot', lead: 'Find a spot.', body: 'Open SpotOn and see private driveways near you, with the hourly price right on the card.' },
  { label: 'Gameday', lead: 'Gameday, handled.', body: 'Search the stadium, your class or any address and book a spot before the crowds show up.' },
  { label: 'Book by the hour', lead: 'Book by the hour.', body: 'Pick your hours and your car. You see the full total before you reserve.' },
  { label: 'Pay your way', lead: 'Pay your way.', body: 'Card, Link, Cash App Pay, Klarna and more, processed securely by Stripe.' },
  { label: 'Your reservation', lead: 'Always know your time.', body: 'Your booking shows the address, a photo of the spot and how long you have left.' },
  { label: 'Message your host', lead: 'Talk to your host.', body: 'Message the host straight from your booking if you need directions or more time.' },
];
const N = steps.length;
const idx = steps.map((_, i) => i + 1);
---
<section id="features" class="features">
  <div class="fx-head wrap center">
    <p class="eyebrow" data-reveal>How it works</p>
    <h2 class="h-section" data-reveal data-reveal-delay="80">Parking, solved<br class="br-m" /> in a few taps.</h2>
  </div>

  <div class="fx-track" style={`--n:${N}`} data-fx-track>
    <div class="fx-sticky" data-fx-sticky>
      <div class="fx-card">
        <div class="fx-chevs" aria-label="Steps">
          <button class="round-btn fx-prev" type="button" aria-label="Previous step" data-fx-prev>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10 8 5.5 12.5 10" /></svg>
          </button>
          <button class="round-btn fx-next" type="button" aria-label="Next step" data-fx-next>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 6 8 10.5 12.5 6" /></svg>
          </button>
        </div>

        <div class="fx-ui">
          <div class="fx-pills" role="group" aria-label="How SpotOn works" data-fx-pills>
            {steps.map((s, i) => (
              <button class="fx-pill" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-step={i}>
                <span class="fx-ico" aria-hidden="true"><i></i><i></i></span>
                <span class="fx-label">{s.label}</span>
              </button>
            ))}
          </div>
          <div class="fx-desc" aria-live="polite">
            {steps.map((s, i) => (
              <p class={`body${i === 0 ? ' is-active' : ''}`} data-desc={i}><strong>{s.lead}</strong> {s.body}</p>
            ))}
          </div>
        </div>

        <div class="fx-stage" aria-hidden="true">
          {idx.map((n) => (
            <img
              class="fx-layer fx-still"
              style={n === 1 ? 'opacity:1' : 'opacity:0'}
              src={`/media/features/pose-${n}.webp`}
              data-m={`/media/features/pose-${n}-m.webp`}
              width="1600" height="900" alt="" loading="lazy" decoding="async"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features { padding: clamp(80px, 11vw, 140px) 0 0; background: var(--bg-alt); }
  .fx-head { padding-bottom: clamp(36px, 5vw, 64px); }
  .br-m { display: none; }
  @media (max-width: 734px) { .br-m { display: inline; } }

  .fx-track { height: calc((var(--n) + .5) * 100vh); height: calc((var(--n) + .5) * 100svh); position: relative; }
  .fx-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; }
  .fx-card {
    position: absolute; top: 68px; right: 24px; bottom: 24px; left: 24px;
    background: var(--paper); border-radius: var(--radius-card); overflow: hidden;
    display: grid; grid-template-columns: 38% 1fr; isolation: isolate;
  }
  .fx-chevs { position: absolute; left: 28px; top: 50%; transform: translateY(-50%); z-index: 3; display: flex; flex-direction: column; gap: 10px; }
  .fx-chevs .round-btn { width: 40px; height: 40px; }

  .fx-ui { align-self: center; padding: 0 12px 0 clamp(84px, 7vw, 100px); position: relative; z-index: 2; }
  .fx-pills { display: flex; flex-direction: column; gap: 10px; }
  .fx-pill {
    display: flex; align-items: center; gap: 12px; width: 100%; text-align: left;
    min-height: clamp(42px, 5.4vh, 50px); padding: 6px 20px 6px 10px; border-radius: var(--radius-pill);
    background: var(--bg-alt); color: var(--ink); font-size: 17px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2;
    transition: background-color .25s ease, transform .2s var(--ease-soft);
  }
  @media (hover: hover) { .fx-pill:hover { background: #d2d1cd; } }
  .fx-pill:active { transform: scale(.97); }
  .fx-ico { position: relative; flex: none; width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--ink); transition: background-color .3s ease, border-color .3s ease; }
  .fx-ico i { position: absolute; left: 50%; top: 50%; width: 10px; height: 1.6px; margin: -.8px 0 0 -5px; background: var(--ink); border-radius: 2px; transition: transform .35s var(--ease-out), background-color .3s ease; }
  .fx-ico i:last-child { transform: rotate(90deg); }
  .fx-pill[aria-pressed='true'] .fx-ico { background: var(--ink-brand); border-color: var(--ink-brand); }
  .fx-pill[aria-pressed='true'] .fx-ico i { background: #fff; }
  .fx-pill[aria-pressed='true'] .fx-ico i:last-child { transform: rotate(0deg); }

  .fx-desc { display: grid; margin-top: 12px; background: var(--bg-alt); border-radius: 24px; padding: 20px 24px; }
  .fx-desc p { grid-area: 1 / 1; opacity: 0; transform: translate3d(0, 8px, 0); transition: opacity .3s ease, transform .3s var(--ease-soft); pointer-events: none; }
  .fx-desc p.is-active { opacity: 1; transform: none; pointer-events: auto; transition-delay: .06s; }

  .fx-stage { position: relative; min-width: 0; min-height: 0; }
  .fx-stage :global(.fx-layer) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    transition: opacity .12s linear;
  }
  .fx-sticky:global(.is-soft) .fx-stage :global(.fx-layer) { transition-duration: .35s; }

  /* ── Tablet ── */
  @media (max-width: 1068px) {
    .fx-card { grid-template-columns: 44% 1fr; }
    .fx-ui { padding-left: 80px; }
    .fx-chevs { left: 20px; }
    .fx-pill { font-size: 16px; }
  }

  /* ── Mobile: stage on top, chips + description below ── */
  @media (max-width: 734px) {
    .fx-card { top: 64px; right: 12px; bottom: 12px; left: 12px; display: flex; flex-direction: column; border-radius: 24px; }
    .fx-chevs { display: none; }
    .fx-stage { order: 1; flex: 1 1 auto; max-height: 62svh; }
    .fx-ui { order: 2; flex: none; align-self: stretch; padding: 0 0 18px; min-width: 0; }
    .fx-pills { flex-direction: row; gap: 8px; overflow-x: auto; padding: 4px 16px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .fx-pills::-webkit-scrollbar { display: none; }
    .fx-pill { width: auto; flex: none; min-height: 40px; padding: 8px 16px; font-size: 15px; }
    .fx-ico { display: none; }
    .fx-pill[aria-pressed='true'] { background: var(--ink-brand); color: #fff; }
    .fx-desc { margin: 10px 16px 0; background: none; padding: 0; min-height: 96px; }
    .fx-desc p { font-size: 17px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx-desc p, .fx-ico, .fx-ico i { transition: none; }
  }
</style>

<script>
  import { initFeatures } from '../scripts/features';
  initFeatures();
</script>
