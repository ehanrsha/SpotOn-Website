---
// "One app. Every spot." — AirPods-page style scroll sequence. While the track scrolls
// past, a pinned canvas scrubs through pre-rendered frames: a phone rises under the
// headline, a second phone slides out from behind it, and both drift up out of frame.
---
<section id="morph" class="morph">
  <div class="mx-track" data-mx>
    <div class="mx-sticky">
      <img class="mx-poster" src="/media/morph-3d/desktop/001.webp" width="1600" height="900" alt="SpotOn on two phones: listing a driveway and finding a spot nearby" decoding="async" data-mx-poster />
      <canvas class="mx-canvas" aria-hidden="true" data-mx-canvas></canvas>
      <div class="mx-head wrap center" data-mx-head>
        <p class="eyebrow">Everything in one place</p>
        <h2 class="h-section">One app. Every spot.</h2>
      </div>
    </div>
  </div>
</section>

<style>
  .morph { background: var(--bg); }
  .mx-track { position: relative; height: 280vh; height: 280svh; }
  .mx-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .mx-poster, .mx-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .mx-poster { object-fit: cover; }
  .mx-canvas { opacity: 0; }
  .mx-canvas.is-ready { opacity: 1; }
  .mx-head { position: relative; z-index: 1; padding-top: clamp(72px, 12vh, 140px); will-change: transform, opacity; }

  @media (prefers-reduced-motion: reduce) {
    .mx-track { height: auto; }
    .mx-sticky { position: relative; height: min(56.25vw, 90svh); min-height: 520px; }
  }
</style>

<script>
  import { initMorph } from '../scripts/morph';
  initMorph();
</script>
