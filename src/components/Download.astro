---
import { APP_STORE } from '../config';
---
<section id="download" class="download section">
  <div class="wrap center">
    <p class="eyebrow" data-reveal>Get SpotOn</p>
    <h2 class="h-section" data-reveal data-reveal-delay="80">Your spot is waiting.</h2>
  </div>

  <div class="phones" data-cta-img>
    <img src="/media/cta/cta-phones.webp" width="1600" height="903" alt="Three iPhones showing the SpotOn home screen, a booking and a listing" loading="lazy" decoding="async" />
  </div>

  <div class="wrap center tail">
    <p class="lead" data-reveal>Free to download. Find a spot near campus today, or list yours and start earning.</p>
    <a class="badge" href={APP_STORE} target="_blank" rel="noopener" aria-label="Download SpotOn on the App Store" data-reveal data-reveal-delay="80">
      <svg viewBox="0 0 384 512" width="26" height="32" fill="currentColor" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" /></svg>
      <span><small>Download on the</small><b>App Store</b></span>
    </a>
  </div>
</section>

<style>
  .download { background: var(--bg); overflow: clip; padding-bottom: clamp(80px, 10vw, 130px); }
  .phones { width: min(1100px, 100%); margin: clamp(16px, 3vw, 40px) auto 0; }
  .phones img { width: 100%; height: auto; mix-blend-mode: multiply; transform: scale(.94); opacity: 0; will-change: transform, opacity; }
  :global(html:not(.js)) .phones img { opacity: 1; transform: none; }
  .tail .lead { max-width: 520px; margin-top: clamp(8px, 2vw, 24px); }
  .badge {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 28px; padding: 8px 22px 8px 16px; border-radius: 14px;
    background: #000; color: #fff; text-decoration: none; border: 1px solid #a6a6a6;
    transition: transform .2s var(--ease-soft), background-color .2s ease;
  }
  .badge:active { transform: scale(.97); }
  @media (hover: hover) { .badge:hover { background: #1a1a1a; } }
  .badge span { display: flex; flex-direction: column; align-items: flex-start; line-height: 1; text-align: left; }
  .badge small { font-size: 11px; font-weight: 400; letter-spacing: 0; }
  .badge b { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; color: #fff; margin-top: 2px; }
  @media (prefers-reduced-motion: reduce) { .phones img { opacity: 1; transform: none; } }
</style>

<script>
  import { initDownload } from '../scripts/download';
  initDownload();
</script>
