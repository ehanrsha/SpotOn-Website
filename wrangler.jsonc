{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spoton",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  // The site is built with Astro, so build it before every deploy.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
